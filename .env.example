PROJECT_NAME=Rigi
# At least 32 bytes: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Zone QR codes are signed with it: changing the key invalidates every printed code.
SECRET_KEY=change-me
DEBUG=True
API_BASE_URL=http://localhost:8000

# These must match: host "db" is the `db` service in compose.override.dev.yaml,
# and POSTGRES_USER/PASSWORD/DB are what that service creates on first start.
# Production (Neon) uses the same postgresql+asyncpg:// scheme with ?ssl=require
# — asyncpg does not understand sslmode or channel_binding.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=rigi_db
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/rigi_db
